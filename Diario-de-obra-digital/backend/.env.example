# Copie este arquivo para ".env" e preencha com seus dados reais.
# O ".env" nunca deve ser enviado pro GitHub (já está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildtrack
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha_do_postgres_aqui

# Qualquer string longa e aleatória serve. Não use essa mesma em produção.
JWT_SECRET=troque_por_uma_string_bem_grande_e_aleatoria
